<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="fammro-widget" type="host">ormmaf.fammro.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="fammro-api" type="host">ormmaf.fammro.com</value>
                <value id="fammro-wss" type="host">wss://ormmaf.fammro.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="fammro-img" type="host">fammro.com</value>
                <value id="fammro-api-img" type="host">ormmaf.fammro.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="fammro-frame" type="host">fammro.com</value>
                <value id="fammro-api-frame" type="host">ormmaf.fammro.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
